{
  "compilerOptions": {
    "module": "ES6",
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "checkJs": true,
    "allowJs": true,
    "moduleResolution": "node",
    "strict": false,
    "noImplicitAny": false
  },
  "include": [
    "static/js/**/*"
  ],
  "exclude": [
    "node_modules"
  ]
}
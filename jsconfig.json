{
  "compilerOptions": {
    "module": "ES2020",
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "checkJs": false,
    "allowJs": true,
    "moduleResolution": "node",
    "strict": false,
    "noImplicitAny": false,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true
  },
  "include": [
    "static/js/**/*"
  ],
  "exclude": [
    "node_modules"
  ]
}